  "benchmark": "DP-FedAvg on real DeepMIMO ray-traced receivers",
  "provenance": {
    "dataset": "DeepMIMO ASU Campus 3.5 GHz",
    "scenario": "asu_campus_3p5",
    "data_kind": "site-specific Wireless InSite ray tracing; not over-the-air capture",
