# VCS
.git
.gitignore
.github

# Python
__pycache__
*.pyc
*.pyo
*.pyd
.pytest_cache
.mypy_cache
.ruff_cache
*.egg-info
.coverage
htmlcov

# Local venv (we rebuild inside the image)
.venv
venv

# IDE / OS
.idea
.vscode
.DS_Store

