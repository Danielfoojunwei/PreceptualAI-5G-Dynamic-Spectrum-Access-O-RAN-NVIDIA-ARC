      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "horizon_audit_chain_length",
          "legendFormat": "audit_chain_length",
          "refId": "A"
        }
      ],
      "title": "Audit chain length",
      "type": "stat"
