# syntax=docker/dockerfile:1.6
# HorizonRIC edge inference agent — Jetson Orin Nano target.
# Single-stage slim image: only the deps the agent needs.

ARG PYTHON_VERSION=3.12
ARG GIT_SHA=unknown
ARG VERSION=0.2.0

FROM python:${PYTHON_VERSION}-slim

ARG GIT_SHA
ARG VERSION

LABEL org.opencontainers.image.title="HorizonRIC Edge Agent" \
      org.opencontainers.image.description="HorizonRIC edge SLA-risk inference agent (Jetson Orin Nano)" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${GIT_SHA}" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.vendor="Preceptual AI"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HORIZON_GIT_SHA=${GIT_SHA} \
    HORIZON_VERSION=${VERSION} \
    HORIZON_HEAD_CKPT=/opt/horizon/checkpoints/sla_head_v0.4_jepa.pt

# Runtime libs only.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libgomp1 \
        tini \
    && rm -rf /var/lib/apt/lists/*

# Non-root user (uid 10000, matching the rApp image).
RUN groupadd --system --gid 10000 horizon \
    && useradd --system --uid 10000 --gid horizon --home /opt/horizon \
       --shell /usr/sbin/nologin horizon \
    && mkdir -p /opt/horizon/checkpoints /opt/horizon/src \
    && chown -R horizon:horizon /opt/horizon

WORKDIR /opt/horizon

# Edge-agent dependencies. We pin to the *minimum* set to keep the image
# small enough for an Orin Nano. Torch CPU wheel is ~190 MB; the alternative
# is to use the NVIDIA L4T base for GPU inference, but we keep this image
# portable so it runs in CI and on the Nano.
RUN pip install --no-cache-dir --upgrade pip setuptools wheel \
    && pip install --no-cache-dir \
        "torch>=2.1,<3.0" \
        "numpy>=1.24" \
        "pydantic>=2.0" \
        "structlog>=24.0" \
        "httpx>=0.27" \
        "prometheus-client>=0.20"

# Source + checkpoint (selectively copied — no pyproject extras needed).
COPY --chown=horizon:horizon src/ /opt/horizon/src/
COPY --chown=horizon:horizon pyproject.toml /opt/horizon/
COPY --chown=horizon:horizon checkpoints/sla_head_v0.4_jepa.pt /opt/horizon/checkpoints/sla_head_v0.4_jepa.pt

# Install the package in editable mode WITHOUT extras (the deps above cover us).
RUN pip install --no-cache-dir --no-deps -e .

USER horizon

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/horizon-edge-agent"]
CMD []
