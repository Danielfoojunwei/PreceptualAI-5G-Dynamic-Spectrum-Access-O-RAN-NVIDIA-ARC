# Horizon-RIC rApp — bare-metal systemd unit.
#
# Install:
#   sudo cp deploy/systemd/horizon-rapp.service /etc/systemd/system/
#   sudo cp .env.example /etc/horizon/horizon.env  # then edit
#   sudo useradd --system --uid 10000 --home /opt/horizon --shell /usr/sbin/nologin horizon
#   sudo install -d -o horizon -g horizon /var/lib/horizon /var/log/horizon
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now horizon-rapp
#
# The service uses Type=notify and WatchdogSec=30; the rApp pings WATCHDOG=1
# every 15s via horizon_ric.rapp.sd_notify. Both run modes speak the
# sd_notify protocol — the bare lifecycle daemon (default ExecStart) and the
# full-pipeline daemon (`--source-config`, sd_notify support landed for
# pipeline mode) — so Type=notify + WatchdogSec stay valid whichever
# ExecStart line below is active.

[Unit]
Description=Horizon-RIC rApp — NTN-Aware AI-RAN Resource-Orchestration
Documentation=https://github.com/preceptualai/horizon-ric
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=main

User=horizon
Group=horizon

WorkingDirectory=/opt/horizon
EnvironmentFile=-/etc/horizon/horizon.env

ExecStart=/opt/horizon/.venv/bin/horizon-rapp

# Full-pipeline mode — telemetry source → planner → Shield → A1 emit instead
# of the bare lifecycle loop. Swap ExecStart for the line below and point
# --source-config at a connector YAML (schema: scripts/local-dev.yaml).
# The pipeline daemon sends READY=1/WATCHDOG=1 too, so no Type= change is
# needed. NOTE: a `file` source whose path does not exist is a HARD ERROR
# at startup in daemon mode — stage real telemetry (under /var/lib/horizon,
# which is in ReadWritePaths) or use a `synthetic` source for dry runs.
#ExecStart=/opt/horizon/.venv/bin/horizon-rapp --source-config /etc/horizon/source.yaml

# A1 dialect + auth env contract, read by the daemon at boot. Prefer setting
# these in /etc/horizon/horizon.env (EnvironmentFile above) — secrets like
# A1_CLIENT_TOKEN and HORIZON_A1_OAUTH_CLIENT_SECRET must ONLY live there,
# never in this unit file. Defaults shown; uncomment to override per-host.
#Environment=HORIZON_A1_DIALECT=osc
#Environment=HORIZON_A1_RIC_ID=ric_emulated_horizon
#Environment=HORIZON_A1_SERVICE_ID=horizon-ric-rapp
#Environment=HORIZON_A1_TIMEOUT_S=10
#Environment=HORIZON_SHIELD_BAND_LO_HZ=3.40e9
#Environment=HORIZON_SHIELD_BAND_HI_HZ=3.50e9
#Environment=HORIZON_SHIELD_MAX_EIRP_DBM=33.0
#Environment=HORIZON_DECISION_BUDGET_MS=1000
#Environment=HORIZON_A1_STATUS_POLL_ATTEMPTS=3
#Environment=HORIZON_A1_STATUS_POLL_INTERVAL_S=1.0

# Graceful shutdown — give the rApp 25s to deregister + flush evidence chain.
TimeoutStartSec=60
TimeoutStopSec=30
KillSignal=SIGTERM
KillMode=mixed

# Watchdog — the rApp pings every 15s, systemd kills + restarts at 30s silence.
WatchdogSec=30

# Resilience.
Restart=on-failure
RestartSec=10
RestartSteps=5
RestartMaxDelaySec=300

# Hardening.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=false
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=

# rApp needs to write to /var/lib/horizon (state + evidence) and /var/log/horizon.
ReadWritePaths=/var/lib/horizon /var/log/horizon

# Resource limits.
LimitNOFILE=65536
LimitNPROC=4096
TasksMax=4096

# Logging — structlog already emits JSON; route to journald.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=horizon-rapp

[Install]
WantedBy=multi-user.target
