# PreceptualAI + NVIDIA Aerial Digital Twin Container
# ---------------------------------------------------------------------------
# Multi-stage build:
#   Stage 1: Extract and build pyAerial from the NVIDIA Aerial SDK container.
#   Stage 2: Install PreceptualAI and runtime dependencies.
#
# Requires NVIDIA Aerial SDK container access (nvcr.io/nvidia/aerial-sdk).
#
# Build:
#   docker build -t preceptualai-aerial:latest \
#     -f docker/Dockerfile.aerial \
#     --build-arg AERIAL_IMAGE=nvcr.io/nvidia/aerial-sdk:24.1 \
#     .
#
# Run (requires NVIDIA GPU):
#   docker run --gpus all -p 50051:50051 -p 9090:9090 \
#     -v ./models:/app/models \
#     preceptualai-aerial:latest
# ---------------------------------------------------------------------------

# ===========================================================================
# Stage 1: Build pyAerial from the Aerial SDK
# ===========================================================================
ARG AERIAL_IMAGE=nvcr.io/nvidia/aerial-sdk:24.1

FROM ${AERIAL_IMAGE} AS aerial-builder

# pyAerial source is typically at /opt/nvidia/aerial/pyaerial
# Build the wheel so we can install it cleanly in the runtime stage
RUN if [ -d /opt/nvidia/aerial/pyaerial ]; then \
        cd /opt/nvidia/aerial/pyaerial && \
        pip install build && \
        python -m build --wheel --outdir /tmp/wheels; \
    fi

# Also grab any pre-built cuPHY shared libraries
RUN mkdir -p /tmp/cuphy_libs && \
    find /opt/nvidia/aerial -name "libcuphy*.so*" -exec cp {} /tmp/cuphy_libs/ \; 2>/dev/null; \
    find /usr/local -name "libcuphy*.so*" -exec cp {} /tmp/cuphy_libs/ \; 2>/dev/null; \
    true

# ===========================================================================
# Stage 2: Runtime image
# ===========================================================================
FROM nvidia/cuda:12.2.2-runtime-ubuntu22.04 AS runtime

LABEL maintainer="preceptualai@example.com"
LABEL org.opencontainers.image.description="PreceptualAI + NVIDIA Aerial Digital Twin"

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

# ---------------------------------------------------------------------------
# System dependencies
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.11 \
        python3.11-venv \
        python3.11-dev \
        python3-pip \
        build-essential \
        cmake \
        curl \
        git \
        libsctp-dev \
        lksctp-tools \
        ca-certificates \
    && update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1 \
    && update-alternatives --install /usr/bin/python python /usr/bin/python3.11 1 \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# Install cuPHY shared libraries from builder stage
# ---------------------------------------------------------------------------
COPY --from=aerial-builder /tmp/cuphy_libs/ /usr/local/lib/
RUN ldconfig

# ---------------------------------------------------------------------------
# Install pyAerial wheel from builder stage
# ---------------------------------------------------------------------------
COPY --from=aerial-builder /tmp/wheels/ /tmp/wheels/
RUN pip install --no-cache-dir /tmp/wheels/*.whl 2>/dev/null || \
    echo "No pyAerial wheel found — will use fallback channel model"

# ---------------------------------------------------------------------------
# Install Sionna (TensorFlow-based 3GPP channel models)
# ---------------------------------------------------------------------------
RUN pip install --no-cache-dir sionna 2>/dev/null || \
    echo "Sionna install skipped (optional)"

# ---------------------------------------------------------------------------
# Install RMR
# ---------------------------------------------------------------------------
ARG RMR_VERSION=4.9.4
RUN curl -fsSL "https://packagecloud.io/o-ran-sc/release/gpgkey" | \
        gpg --dearmor -o /usr/share/keyrings/o-ran-sc.gpg 2>/dev/null && \
    echo "deb [signed-by=/usr/share/keyrings/o-ran-sc.gpg] https://packagecloud.io/o-ran-sc/release/ubuntu/ jammy main" \
        > /etc/apt/sources.list.d/o-ran-sc.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends rmr-dev rmr 2>/dev/null || true && \
    rm -rf /var/lib/apt/lists/*

# Fallback: build from source
RUN if ! ldconfig -p | grep -q librmr; then \
        git clone --depth 1 --branch ${RMR_VERSION} \
            https://gerrit.o-ran-sc.org/r/ric-plt/lib/rmr /tmp/rmr 2>/dev/null && \
        cd /tmp/rmr && mkdir build && cd build && \
        cmake -DDEV_PKG=1 .. && make -j"$(nproc)" install && ldconfig && \
        rm -rf /tmp/rmr; \
    fi || true

# ---------------------------------------------------------------------------
# Python dependencies
# ---------------------------------------------------------------------------
WORKDIR /app

COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
RUN pip install --no-cache-dir cupy-cuda12x 2>/dev/null || \
    echo "CuPy install skipped (optional, needed for GPU channel estimation)"

# ---------------------------------------------------------------------------
# Install PreceptualAI
# ---------------------------------------------------------------------------
COPY pyproject.toml /app/pyproject.toml
COPY src/ /app/src/
COPY proto/ /app/proto/

RUN mkdir -p /app/src/preceptualai/proto && \
    touch /app/src/preceptualai/proto/__init__.py && \
    python -m grpc_tools.protoc \
        -Iproto \
        --python_out=src/preceptualai/proto \
        --grpc_python_out=src/preceptualai/proto \
        proto/preceptualai.proto \
    || true

RUN pip install --no-cache-dir -e .

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
EXPOSE 50051
EXPOSE 9090

ENV RMR_SEED_RT=/app/routes.rt \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility
RUN echo "newrt | start\nnewrt | end" > /app/routes.rt

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD python -c "import grpc; ch=grpc.insecure_channel('localhost:50051'); grpc.channel_ready_future(ch).result(timeout=3)" || exit 1

ENTRYPOINT ["python", "-m", "preceptualai.xapp.server"]
CMD ["--config", "/app/config.yaml"]
