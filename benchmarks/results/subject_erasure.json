    "rounds": 12,
    "model_dim": 36,
    "subject": "one real DeepMIMO receiver (receiver_index) and its 6 measured gains",
    "erasure_mechanism": "exact rank-1 downdate of the client's sufficient statistics (D\u1d40D, D\u1d40T, n), replayed through every warm-started round",
    "gold_standard": "independent from-scratch retrain of the whole federation from the raw real rows with the subject's row physically deleted",
