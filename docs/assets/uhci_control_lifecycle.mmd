flowchart LR
    %% UHCI control and lifecycle interaction view

    subgraph Online["Online Control Loop"]
        obs["Telemetry / State Observations"]
        encode["Graph + Temporal Encoding\nhetero_gnn_encoder.py\nltc_cell_cfc.py"]
        decide["Universal Decision Policy\nuniversal_spectrum_agent.py"]
        serve["Inference Runtime\ninference_engine.py / dapp_engine.py"]
        act["Control Actions\nallocation • routing • steering • scheduling"]
        net["Heterogeneous Network Fabric\nNTN + terrestrial + edge domains"]
    end

    subgraph O_RAN["O-RAN and Service Interfaces"]
        grpc["gRPC API\nserver.py"]
        e2["E2 Adapter\ne2_adapter.py"]
        oran["O-RAN Environment Surface\noran.py"]
        rapp["Non-RT RIC / rApp Trainer\nrapp_trainer.py"]
    end

    subgraph Learning["Offline and Continuous Learning Loop"]
        data["Unified Data Pipeline\ndata_pipeline.py"]
        trainer["Training Pipeline\nscripts/train_uhci.py"]
        bench["Benchmark Harness\nbenchmark.py + summary.json"]
        registry["Model Registry / Approval / Deployment"]
    end

    subgraph Federated["Optional Federated Extension"]
        edgeclients["Edge Clients / Sites"]
        flproto["FL Contracts\npreceptualai_fl.proto"]
        agg["Hybrid Federated Aggregator\naggregator.py"]
        global["Global / Personalized Model Update"]
    end

    obs --> oran
    oran --> encode
    encode --> decide
    decide --> serve
    serve --> act
    act --> net
    net --> obs

    serve --> grpc
    serve --> e2
    e2 --> net
    rapp --> registry
    registry --> serve

    obs --> data
    data --> trainer
    trainer --> bench
    bench --> registry
    registry --> decide
    registry --> encode

    edgeclients --> flproto
    flproto --> agg
    agg --> global
    global --> trainer
    registry --> rapp

    classDef online fill:#ebf8ff,stroke:#2b6cb0,stroke-width:1px,color:#1a202c;
    classDef control fill:#f0fff4,stroke:#2f855a,stroke-width:1px,color:#1a202c;
    classDef lifecycle fill:#fffaf0,stroke:#c05621,stroke-width:1px,color:#1a202c;
    classDef federated fill:#faf5ff,stroke:#805ad5,stroke-width:1px,color:#1a202c;

    class obs,encode,decide,serve,act,net online;
    class grpc,e2,oran,rapp control;
    class data,trainer,bench,registry lifecycle;
    class edgeclients,flproto,agg,global federated;
